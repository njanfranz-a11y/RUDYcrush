# Copy to .env.local for local production builds, or set this in the
# Cloudflare Pages dashboard (Production and Preview environments).
#
# Use your Railway public domain. The value may be either the host URL or the
# full API base; the app appends /api/v1 when it is missing.
VITE_API_BASE_URL=https://your-service.up.railway.app/api/v1
