# Production values for the Railway service.
# Set these in the Railway dashboard (Variables), never commit real secrets.
APP_NAME=RoadWatch
APP_ENV=production
# Optional: the container generates and persists one when omitted. Setting it
# here is still recommended so sessions survive a storage-volume reset.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service.up.railway.app

# Cloudflare Pages origin(s). Comma-separate a custom domain if you have one.
# *.pages.dev preview deployments are allowed automatically by config/cors.php.
FRONTEND_URL=https://your-project.pages.dev

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Railway MySQL service. DB_URL is the full DSN and overrides the DB_* values.
# In the Railway dashboard use the variable picker:
#   ${{MySQL.MYSQL_URL}}
DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PATH=/
SESSION_DOMAIN=null

# Optional but useful if you switch from bearer tokens to Sanctum SPA cookies.
# SANCTUM_STATEFUL_DOMAINS=your-project.pages.dev

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Entrypoint defaults: migrate and seed on every start. Both are idempotent.
# Set AUTO_SEED=false after the first deploy if you do not want the seeder to
# ensure categories on each boot.
AUTO_MIGRATE=true
AUTO_SEED=true

# Optional regex for an extra wildcard frontend domain.
# FRONTEND_ORIGIN_PATTERN=#^https://[a-z0-9-]+\.roadwatch\.example\.com$#
