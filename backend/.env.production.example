# Production values for the Railway service.
# Set these in the Railway dashboard (Variables), never commit real secrets.
APP_NAME=RoadWatch
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://your-service.up.railway.app

# Cloudflare Pages origin. Required by config/cors.php.
FRONTEND_URL=https://your-project.pages.dev

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Railway MySQL service. DB_URL is the full DSN and overrides the DB_* values.
DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Set to true for one deploy to run migrations and seed the demo accounts,
# then set it back to false (or remove it).
AUTO_MIGRATE=false
